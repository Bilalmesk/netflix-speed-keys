{
  "manifest_version": 3,
  "name": "Netflix Speed Keys",
  "version": "1.1.0",
  "description": "Use + and − to change Netflix playback speed while subtitles stay in sync.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
